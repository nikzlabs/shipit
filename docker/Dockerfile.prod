FROM node:24-slim@sha256:4e6b70dd6cbfc88c8157ba19aa3d9f9cce6ba4703576d55459e45efcbc9c5f5d AS build

# Keep this prefix identical to the worker build to share BuildKit cache records.
RUN apt-get update && apt-get install -y python3 make g++ && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY package.json package-lock.json ./
RUN --mount=type=cache,target=/root/.npm npm ci --prefer-offline

COPY . .

# Scope the per-deploy ID below the shared prefix; .git is excluded from the build.
ARG SHIPIT_BUILD_ID
RUN SHIPIT_BUILD_ID=${SHIPIT_BUILD_ID} npm run build

RUN --mount=type=cache,target=/root/.npm npm prune --omit=dev && npm install tsx

FROM node:24-slim@sha256:4e6b70dd6cbfc88c8157ba19aa3d9f9cce6ba4703576d55459e45efcbc9c5f5d
ARG SHIPIT_BUILD_ID

RUN apt-get update && apt-get install -y acl git git-lfs curl ca-certificates gnupg \
    && install -m 0755 -d /etc/apt/keyrings \
    && curl -fsSL https://download.docker.com/linux/debian/gpg | gpg --dearmor -o /etc/apt/keyrings/docker.gpg \
    && echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.gpg] https://download.docker.com/linux/debian bookworm stable" > /etc/apt/sources.list.d/docker.list \
    && apt-get update && apt-get install -y docker-ce-cli docker-compose-plugin \
    && rm -rf /var/lib/apt/lists/*

# Clean writes LFS pointers; smudge would fail against a local bare-cache remote.
RUN git lfs install --system --skip-repo --skip-smudge

ARG SHIPIT_HARNESSES=
COPY docker/agent-cli/package.json docker/agent-cli/package-lock.json /opt/agent-cli/
COPY docker/agent-cli/install-agent-clis.sh /usr/local/bin/install-agent-clis
RUN chmod 0755 /usr/local/bin/install-agent-clis
RUN --mount=type=cache,target=/root/.npm install-agent-clis
ENV PATH="/opt/agent-cli/node_modules/.bin:${PATH}"

# Absorb store/erase calls from workspace-local broker settings; global auth answers get.
RUN printf '#!/bin/sh\nexec cat >/dev/null 2>&1\n' > /usr/local/bin/shipit-git-credential \
 && chmod 0755 /usr/local/bin/shipit-git-credential

WORKDIR /app

COPY --from=build /app/node_modules ./node_modules

COPY package.json package-lock.json ./
COPY tsconfig.json ./
COPY src/server/orchestrator/ ./src/server/orchestrator/
COPY src/server/shared/ ./src/server/shared/
COPY --from=build /app/dist/client ./dist/client

RUN mkdir -p /workspace /credentials /root/.local/share \
 && ln -s /credentials/.claude /root/.claude \
 && ln -sf /credentials/.claude.json /root/.claude.json \
 && ln -s /credentials/.codex /root/.codex \
 && ln -s /credentials/.local/share/opencode /root/.local/share/opencode \
 && ln -s /credentials/.grok /root/.grok
VOLUME /workspace
VOLUME /credentials

ENV NODE_ENV=production
ENV SHIPIT_BUILD_ID=${SHIPIT_BUILD_ID}

COPY docker/secrets-entrypoint.sh /usr/local/share/shipit/secrets-entrypoint.sh
RUN chmod 0755 /usr/local/share/shipit/secrets-entrypoint.sh

EXPOSE 3000 5173

CMD ["node", "--import", "tsx", "src/server/orchestrator/index.ts"]
