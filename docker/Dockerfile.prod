# ---- Build stage (full image has python3/make/gcc for native addons) ----
FROM node:24-slim@sha256:4e6b70dd6cbfc88c8157ba19aa3d9f9cce6ba4703576d55459e45efcbc9c5f5d AS build

# The next four instructions are DELIBERATELY byte-identical to the opening of
# Dockerfile.session-worker.prod's build stage, on the same pinned base. BuildKit's
# cache is content-addressed rather than per-Dockerfile, so the two images share
# one set of records for the apt layer and the `npm ci` — build one, get the other
# free. Diverging here does not cost a little, it builds the whole prefix twice.
#
# Which is why SHIPIT_BUILD_ID must NOT enter the prefix. deploy.sh passes the git
# HEAD sha, so an `ENV` up here changes on EVERY update, invalidating every layer
# below it AND forking this chain away from the worker's. A production
# `docker buildx du --verbose` taken while it sat at the top of this stage showed
# the damage: `apt-get install python3 make g++` twice at 349.8MB and
# `npm ci --prefer-offline` twice at 587.1MB, with the base image's own layers
# appearing once. It is declared below instead, next to the one build step that
# needs it. Guarded by src/server/orchestrator/docker-build-cache.test.ts.

RUN apt-get update && apt-get install -y python3 make g++ && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY package.json package-lock.json ./
RUN --mount=type=cache,target=/root/.npm npm ci --prefer-offline

COPY . .

# The client bundle DOES need the build id at build time: vite.config.ts
# `resolveBuildId()` reads $SHIPIT_BUILD_ID and bakes it into
# `__SHIPIT_CLIENT_BUILD_ID__`, which `shouldReloadForServerBuild`
# (src/client/utils/client-build.ts) compares against the server's to reload a
# stale SPA after a deploy. Its git fallback cannot help here — `.git` is in
# .dockerignore — so an unset value silently returns `undefined`, and that
# comparison then short-circuits to `false` forever: no error, no failed build,
# just users left on the pre-update client.
#
# So it is declared HERE rather than at the top of the stage. Everything above is
# the prefix shared with Dockerfile.session-worker.prod and must stay identical;
# from `COPY . .` down the source has changed anyway, so consuming a per-deploy
# value costs nothing that was going to be cached. Scoped to this one RUN rather
# than an `ENV` so it can't leak back up if the steps are ever reordered.
ARG SHIPIT_BUILD_ID
RUN SHIPIT_BUILD_ID=${SHIPIT_BUILD_ID} npm run build

# Prune devDependencies so we can copy a clean node_modules to prod
RUN --mount=type=cache,target=/root/.npm npm prune --omit=dev && npm install tsx

# ---- Production image ----
FROM node:24-slim@sha256:4e6b70dd6cbfc88c8157ba19aa3d9f9cce6ba4703576d55459e45efcbc9c5f5d
ARG SHIPIT_BUILD_ID

RUN apt-get update && apt-get install -y git git-lfs curl ca-certificates gnupg \
    && install -m 0755 -d /etc/apt/keyrings \
    && curl -fsSL https://download.docker.com/linux/debian/gpg | gpg --dearmor -o /etc/apt/keyrings/docker.gpg \
    && echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.gpg] https://download.docker.com/linux/debian bookworm stable" > /etc/apt/sources.list.d/docker.list \
    && apt-get update && apt-get install -y docker-ce-cli docker-compose-plugin \
    && rm -rf /var/lib/apt/lists/*

# docs/231 — Git LFS in the ORCHESTRATOR, installed with `--skip-smudge`.
#
# The clean filter is load-bearing: `postTurnCommit` runs orchestrator-side
# against the session's bind-mounted workspace, so without it `git add -A` would
# commit raw binaries into an LFS repo and corrupt it.
#
# Smudge is deliberately OFF. `RepoGit.cloneFromCache` runs `git clone --local`
# from the bare cache, whose `origin` is a local filesystem path at that moment;
# an active smudge filter would try to resolve an LFS endpoint from that path,
# fail, and — because `filter.lfs.required = true` — fail the whole checkout.
# Content is instead materialized explicitly by a batched `git lfs pull` at the
# end of provisioning (src/server/orchestrator/git-lfs.ts), which is also faster
# than smudge's serial per-file downloads.
RUN git lfs install --system --skip-repo --skip-smudge

# Agent CLIs for local/dogfood mode (RUNTIME_MODE=local spawns the adapters
# in-process inside this orchestrator container — see app-di.ts
# buildLocalAgentFactory). Lockfile-pinned, integrity-verified install shared
# with the worker images (docs/141); canonical comment in
# Dockerfile.session-worker.prod. Now includes @playwright/mcp via the shared
# manifest, reconciling the prior prod/dev omission.
#
# docs/252 phase 9 (req 14) — WHICH harnesses get installed is a build input,
# defaulting to Claude Code and Codex. This image matters as much as the worker
# image does: the orchestrator answers what the picker offers and runs session
# naming locally, so a selection applied only to the worker would leave an
# uninstalled harness still offered and still used for background work. The
# installer writes /opt/shipit/agents/installed.json, which the orchestrator reads
# instead of probing its own $PATH.
ARG SHIPIT_HARNESSES=claude,codex
COPY docker/agent-cli/package.json docker/agent-cli/package-lock.json /opt/agent-cli/
COPY docker/agent-cli/install-agent-clis.sh /usr/local/bin/install-agent-clis
RUN chmod 0755 /usr/local/bin/install-agent-clis
RUN --mount=type=cache,target=/root/.npm install-agent-clis
ENV PATH="/opt/agent-cli/node_modules/.bin:${PATH}"

# No-op git credential helper (docs/192 / SHI follow-up). Session workspaces
# carry a *local* `credential.helper = /usr/local/bin/shipit-git-credential` so
# the in-container agent resolves the brokered GitHub token (docs/088). That
# brokering binary is installed only in the session-worker images. When the
# orchestrator runs git against such a workspace (auto-push, `gh pr create`,
# ls-remote for the force-push lease), git answers `get` from the orchestrator's
# own global inline helper (consulted first) but still broadcasts `store`/`erase`
# to EVERY configured helper — including the local broker, which here resolves to
# a path that does not exist → `shipit-git-credential ...: not found` on every
# push. Installing a silent no-op at that path absorbs the broker's
# get/store/erase calls (cat drains stdin, prints nothing, exits 0) so the
# orchestrator's own global helper remains the sole credential source.
RUN printf '#!/bin/sh\nexec cat >/dev/null 2>&1\n' > /usr/local/bin/shipit-git-credential \
 && chmod 0755 /usr/local/bin/shipit-git-credential

WORKDIR /app

# Copy pre-built node_modules from build stage (includes compiled node-pty)
COPY --from=build /app/node_modules ./node_modules

# Copy only server source needed at runtime (no client source, tests, or docs).
# Session code runs inside per-session containers — the orchestrator only needs
# its own code and the shared layer (types, AgentRegistry, GitManager). The
# local-mode (feature 118) agent adapters live in session/ but are loaded via
# dynamic import in app-di.ts only when RUNTIME_MODE=local; that path uses the
# dev image (which bind-mounts the full repo), not this prod image.
COPY package.json package-lock.json ./
COPY tsconfig.json ./
COPY src/server/orchestrator/ ./src/server/orchestrator/
COPY src/server/shared/ ./src/server/shared/
COPY --from=build /app/dist/client ./dist/client

# Workspace for user projects — each session creates its own git repo.
# Symlink Claude + Codex credential directories into /credentials so OAuth
# logins (Claude) and ChatGPT subscription logins (Codex) survive container
# restarts and idle cleanup. See docs/119-codex-subscription-auth/plan.md.
RUN mkdir -p /workspace /credentials /root/.local/share \
 && ln -s /credentials/.claude /root/.claude \
 && ln -sf /credentials/.claude.json /root/.claude.json \
 && ln -s /credentials/.codex /root/.codex \
 && ln -s /credentials/.local/share/opencode /root/.local/share/opencode
VOLUME /workspace
VOLUME /credentials

ENV NODE_ENV=production
ENV SHIPIT_BUILD_ID=${SHIPIT_BUILD_ID}

# Bake in the secrets entrypoint wrapper (087-reusable-preview-secrets,
# Phase 1 follow-up). Mounted into compose service containers at
# `/shipit/secrets-entrypoint.sh` so they can pick up Docker secrets as env
# vars without modifying user code.
COPY docker/secrets-entrypoint.sh /usr/local/share/shipit/secrets-entrypoint.sh
RUN chmod 0755 /usr/local/share/shipit/secrets-entrypoint.sh

EXPOSE 3000 5173

CMD ["node", "--import", "tsx", "src/server/orchestrator/index.ts"]
