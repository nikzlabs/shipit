# Match the worker's Node digest: both containers share compiled native dependencies.
FROM node:24-slim@sha256:4e6b70dd6cbfc88c8157ba19aa3d9f9cce6ba4703576d55459e45efcbc9c5f5d

WORKDIR /workspace

RUN apt-get update \
    && apt-get install -y acl git git-lfs curl python3 make g++ zip unzip ripgrep bubblewrap \
    && rm -rf /var/lib/apt/lists/*

RUN git lfs install --system --skip-repo --skip-smudge

ARG SHIPIT_HARNESSES=
COPY docker/agent-cli/package.json docker/agent-cli/package-lock.json /opt/agent-cli/
COPY docker/agent-cli/install-agent-clis.sh /usr/local/bin/install-agent-clis
RUN chmod 0755 /usr/local/bin/install-agent-clis
RUN --mount=type=cache,target=/root/.npm install-agent-clis
ENV PATH="/opt/agent-cli/node_modules/.bin:${PATH}"

# Browser binaries must be readable by the non-root runtime UID.
ENV PLAYWRIGHT_BROWSERS_PATH=/opt/playwright-browsers
RUN mkdir -p /opt/playwright-browsers \
 && playwright install-deps chromium \
 && HOME=/opt/playwright-browsers playwright-mcp install-browser chrome-for-testing \
 && chmod -R a+rX /opt/playwright-browsers

# Absorb store/erase calls from workspace-local broker settings; global auth answers get.
RUN printf '#!/bin/sh\nexec cat >/dev/null 2>&1\n' > /usr/local/bin/shipit-git-credential \
 && chmod 0755 /usr/local/bin/shipit-git-credential

COPY docker/agent-hooks/stop-pr-check.sh /etc/shipit/agent-hooks/stop-pr-check.sh
COPY docker/agent-hooks/block-branch-ops.mjs /etc/shipit/agent-hooks/block-branch-ops.mjs
COPY docker/agent-hooks/managed-settings.json /etc/shipit/managed-settings.json
RUN chmod 0755 /etc/shipit/agent-hooks/stop-pr-check.sh /etc/shipit/agent-hooks/block-branch-ops.mjs

# Use absolute checkout paths so tsx resolution does not depend on the caller's cwd.
RUN printf '#!/bin/sh\nexec /workspace/node_modules/.bin/tsx /workspace/src/server/session/agent-shim/gh.ts "$@"\n' > /usr/local/bin/gh \
 && chmod 0755 /usr/local/bin/gh

# Compose overrides both homes with a writable path for its session UID.
ENV HOME=/root
ENV AGENT_HOME=/root
