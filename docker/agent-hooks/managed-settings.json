{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "_comment": "ShipIt-managed Claude Code settings. The hooks protect the session branch and enforce PR creation when enabled.",
  "_permissions_comment": "Explicit file-tool permissions protect settings and credential files while keeping project memory writable.",
  "_connectors_comment": "Disable account connectors because session containers cannot complete their OAuth flows.",
  "includeCoAuthoredBy": false,
  "disableClaudeAiConnectors": true,
  "permissions": {
    "allow": [
      "Read(**)",
      "Edit(**)",
      "Write(**)",
      "NotebookEdit(**)",
      "Bash",
      "Glob(**)",
      "Grep(**)",
      "WebFetch",
      "WebSearch",
      "AskUserQuestion"
    ],
    "deny": [
      "Edit(/etc/shipit/**)",
      "Write(/etc/shipit/**)",
      "NotebookEdit(/etc/shipit/**)",
      "Edit(/root/.claude/.credentials.json)",
      "Write(/root/.claude/.credentials.json)",
      "Edit(/root/.claude/credentials.json)",
      "Write(/root/.claude/credentials.json)",
      "Edit(/root/.claude/auth.json)",
      "Write(/root/.claude/auth.json)",
      "Edit(/root/.claude/settings.json)",
      "Write(/root/.claude/settings.json)",
      "Edit(/root/.claude/settings.local.json)",
      "Write(/root/.claude/settings.local.json)",
      "Edit(/root/.claude.json)",
      "Write(/root/.claude.json)",
      "Edit(/credentials/.claude/.credentials.json)",
      "Write(/credentials/.claude/.credentials.json)",
      "Edit(/credentials/.claude/credentials.json)",
      "Write(/credentials/.claude/credentials.json)",
      "Edit(/credentials/.claude/auth.json)",
      "Write(/credentials/.claude/auth.json)",
      "Edit(/credentials/.claude.json)",
      "Write(/credentials/.claude.json)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/etc/shipit/agent-hooks/block-branch-ops.mjs"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/etc/shipit/agent-hooks/stop-pr-check.sh"
          }
        ]
      }
    ]
  }
}
